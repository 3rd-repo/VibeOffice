<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The DMG edition (Developer ID, notarized; also the ad-hoc smoke build): sandboxed as the App Store edition is, so
     testing one tests both. Files the user picks or opens from Finder; the Downloads folder, where saves go for now
     (docs/desktop.md, Saving); printing; the network only for the update check (updater/current.json). -->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>
	<key>com.apple.security.print</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
