<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The Mac App Store edition: the DMG's entitlements without the network (the store updates it, so nothing is
     fetched), with the identifiers the provisioning profile carries; build.sh fills in @TEAM@ (APPLE_TEAM_ID). -->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>
	<key>com.apple.security.print</key>
	<true/>
	<key>com.apple.application-identifier</key>
	<string>@TEAM@.work.vibeoffice.desktop</string>
	<key>com.apple.developer.team-identifier</key>
	<string>@TEAM@</string>
</dict>
</plist>
